# Copy to .env and edit. Never commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO

MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=fitvision

# Comma-separated list of allowed browser origins
FRONTEND_URL=http://localhost:3000

# Used from Phase 3. Generate a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-this-secret-in-your-env-file
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Used from Phase 9. Leave as "none" to run without an AI provider.
AI_PROVIDER=none
AI_API_KEY=
